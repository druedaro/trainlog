rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Entries: users can only read/write their own entries
    match /entries/{entryId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.transcript is string
                    && request.resource.data.transcript.size() > 0
                    && request.resource.data.analysis is map
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // User Profile: users can read/write their own root profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Discover: users can read/write their own discover articles
    match /users/{userId}/discover/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Explore: users can read/write their own explore articles
    match /users/{userId}/explore/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Insights: users can read/write their own insights
    match /users/{userId}/insights/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Saved Articles: users can read/write their own saved articles
    match /users/{userId}/savedArticles/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
